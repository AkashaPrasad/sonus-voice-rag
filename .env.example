# Copy to .env and fill in. Never commit the filled version.

# ── Core ─────────────────────────────────────────────────
APP_ENV=production
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=*

# ── Generation (quality path, outside the 200ms budget) ──
# Comma-separated. Keys are rotated; a 429/401 cools that key down rather than
# being retried in a tight loop, so N keys give roughly N times the free quota.
GROQ_API_KEYS=
# llama-3.1-8b-instant is RETIRED on Groq and returns 404. Verified against the
# live model list; gpt-oss-20b answers in the query language with [n] citations.
GROQ_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=180
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=4000

# ── Speech to text ───────────────────────────────────────
STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# Falls back to Groq Whisper (whisper-large-v3-turbo) using GROQ_API_KEYS.

# ── Retrieval / index ────────────────────────────────────
HF_TOKEN=
CORPUS_PROFILE=dev              # dev | demo | full
CORPUS_LANGS=hi,ta,te,bn
CORPUS_ROWS_PER_LANG=1000
EMBED_MODEL=minishlab/potion-multilingual-128M
EMBED_DIM=256
# Winner of bench/chunking_eval.py -- do not guess this.
CHUNK_STRATEGY=s5_hierarchical
INDEX_PATH=/app/index
TOP_K_DENSE=50
TOP_K_SPARSE=50
RRF_K=60
RRF_ALPHA=0.6
MMR_LAMBDA=0.7
CROSS_LINGUAL=true

# ── Latency ──────────────────────────────────────────────
LATENCY_BUDGET_MS=200
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIZE=2048
SEMANTIC_CACHE_THRESHOLD=0.97
WARMUP_QUERIES=24

# ── Guardrails ───────────────────────────────────────────
# CALIBRATED on 300 verbatim + 13 paraphrase in-domain vs 14 same-language OOD
# queries -- see bench/abstain_calibration.json. Do not ship a guess.
ABSTAIN_THRESHOLD=0.44
GROUNDEDNESS_THRESHOLD=0.55
MIN_SCORE_GAP=0.0
PII_REDACTION=true

# ── Frontend (.env.local) ────────────────────────────────
VITE_API_BASE=https://api.sonus.spacesdrive.cc
